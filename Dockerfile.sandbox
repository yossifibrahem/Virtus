# Virtus model computer for standalone chats and shared Folder/Project runtimes.
#
# First-run/developer build:
#   docker build --build-arg VIRTUS_SANDBOX_IDENTITY=<content-sha256> \
#     -f Dockerfile.sandbox -t virtus-sandbox:latest .

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Support user-configured Node MCP servers and the optional mcp-remote bridge.
# Virtus does not bundle or automatically launch an MCP server.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /usr/share/keyrings/nodesource.gpg \
    && printf 'Types: deb\nURIs: https://deb.nodesource.com/node_22.x\nSuites: nodistro\nComponents: main\nArchitectures: %s\nSigned-By: /usr/share/keyrings/nodesource.gpg\n' \
       "$(dpkg --print-architecture)" \
       > /etc/apt/sources.list.d/nodesource.sources \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    bc \
    build-essential \
    coreutils \
    diffutils \
    dnsutils \
    file \
    findutils \
    git \
    grep \
    gzip \
    iputils-ping \
    jq \
    less \
    make \
    netcat-openbsd \
    openssl \
    patch \
    pkg-config \
    procps \
    python3 \
    python3-pip \
    python3-venv \
    sed \
    tar \
    unzip \
    wget \
    xz-utils \
    zip \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip3 install --no-cache-dir uv \
    && python -m pip install --no-cache-dir \
        beautifulsoup4 \
        httpx \
        lxml \
        openpyxl \
        pandas \
        Pillow \
        PyMuPDF \
        python-dotenv \
        requests

RUN npm install -g mcp-remote@0.1.38 \
    && npm cache clean --force

ARG VIRTUS_SANDBOX_IDENTITY=unidentified
LABEL org.opencontainers.image.title="Virtus MCP Sandbox" \
      org.opencontainers.image.source="https://github.com/yossifibrahem/virtus-ai-chat" \
      com.virtus.sandbox.identity="${VIRTUS_SANDBOX_IDENTITY}"

COPY sandbox_tools.py /opt/virtus/sandbox_tools.py
COPY sandbox_files.py /opt/virtus/sandbox_files.py
WORKDIR /workspace
CMD ["sleep", "infinity"]
